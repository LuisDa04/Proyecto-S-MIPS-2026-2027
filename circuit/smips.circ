    <comp lib="7" loc="(860,1300)" name="Text">
      <a name="font" val="SansSerif bold 22"/>
      <a name="text"> Ecuación
IsAdd (OP = 00) AND (Funct = 20)
IsAddu (OP = 00) AND (Funct = 21)
IsSub (OP = 00) AND (Funct = 22)
IsAnd (OP = 00) AND (Funct = 24)
IsOr (OP = 00) AND (Funct = 25)
IsSlt (OP = 00) AND (Funct = 2A)
IsSll (OP = 00) AND (Funct = 00)
IsSrl (OP = 00) AND (Funct = 02)
IsJr (OP = 00) AND (Funct = 08)
IsSysCall (OP = 00) AND (Funct = 0C)</a>
    </comp>
    <comp lib="7" loc="(950,1000)" name="Text">
      <a name="font" val="SansSerif bold 22"/>
      <a name="text">Ecuación
IsBeq OP = 04
IsBne OP = 05
IsJ OP = 02
IsJal OP = 03</a>
    </comp>
    <comp lib="7" loc="(960,160)" name="Text">
      <a name="font" val="SansSerif bold 22"/>
      <a name="text">Ecuación
IsAddi OP = 08
IsAddiu OP = 09
IsSlti OP = 0A
IsAndi OP = 0C
IsOri OP = 0D
IsLui OP = 0F</a>
    </comp>
    <comp lib="7" loc="(960,630)" name="Text">
      <a name="font" val="SansSerif bold 22"/>
      <a name="text"> Ecuación
IsLw OP = 23
IsLb OP = 20
IsLbu OP = 24
IsSw OP = 2B
IsSb OP = 28</a>
    </comp>
